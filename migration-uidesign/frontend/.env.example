# Public API base URL. This value is embedded when the frontend is built.
NEXT_PUBLIC_API_BASE_URL=https://YOUR_DOMAIN/backend
NEXT_PUBLIC_MINIGAMES_FRONTEND_URL=https://minigames.YOUR_DOMAIN
MEDIA_DIR=/app/uploads
# Server-side API address for validating upload sessions (Compose uses http://backend:3000).
UPLOAD_AUTH_API_BASE_URL=http://localhost:3000
# Public JSON mapping hero IDs or names to HTTPS R2 video URLs. Must allow CORS.
NEXT_PUBLIC_HERO_VIDEO_MANIFEST_URL=
