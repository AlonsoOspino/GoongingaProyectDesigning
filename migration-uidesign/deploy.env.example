# Public addresses used for the first deployment by IP and port.
# Rebuild the frontend after changing NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:3000

# Host ports. Use different ports for future applications.
GOON_API_BIND_ADDRESS=0.0.0.0
GOON_API_PORT=3000
GOON_FRONTEND_BIND_ADDRESS=0.0.0.0
GOON_FRONTEND_PORT=3001
