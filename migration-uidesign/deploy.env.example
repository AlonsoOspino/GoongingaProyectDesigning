# Public domains consumed at frontend build time. Caddy routes /backend to the
# Express service; application ports stay private to the VPS.
GOON_DOMAIN=goongingaleague.duckdns.org
GOON_GAMENIGHTS_DOMAIN=goonginga-gamenights.duckdns.org
NEXT_PUBLIC_API_BASE_URL=https://goongingaleague.duckdns.org/backend
NEXT_PUBLIC_MINIGAMES_API_BASE_URL=https://goongingaleague.duckdns.org/backend

# Internal PostgreSQL credentials. Generate a unique, long password and do not
# expose port 5432 publicly.
POSTGRES_DB=goonginga
POSTGRES_USER=goonginga
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Host ports. Use different ports for future applications.
GOON_API_BIND_ADDRESS=127.0.0.1
GOON_API_PORT=3000
GOON_FRONTEND_BIND_ADDRESS=127.0.0.1
GOON_FRONTEND_PORT=3001
