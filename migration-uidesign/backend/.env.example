# Required PostgreSQL/Prisma connection strings. The Docker service is named
# "database", so it is never exposed on a public network port.
DATABASE_URL=postgresql://goonginga:replace-with-db-password@database:5432/goonginga?schema=public
DIRECT_URL=postgresql://goonginga:replace-with-db-password@database:5432/goonginga?schema=public

# Required application secrets. Generate unique values; never commit the real .env file.
JWT_SECRET=replace-with-a-long-random-secret
DRAFT_TABLE_MANAGER_KEY=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-secret

# Comma-separated public frontend origins allowed to call this API.
CORS_ORIGIN=http://YOUR_SERVER_IP:3001
MEDIA_DIR=/app/uploads

# Optional integrations.
# GOOGLE_VISION_API_KEY=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=987039120004104232
# DISCORD_REDIRECT_URI=http://YOUR_SERVER_IP:3000/network-auth/discord/callback
# NETWORK_FRONTEND_URL=http://YOUR_SERVER_IP:3001
# NETWORK_JWT_SECRET=
# ENABLE_DRAFT_TIMEOUT_WORKER=true
