generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id        Int             @id @default(autoincrement())
  name      String
  startDate DateTime
  state     TournamentState @default(SCHEDULED)
  matches   Match[]
  teams     Team[]
  wrapped   Wrapped?
}

model Wrapped {
  id           Int        @id @default(autoincrement())
  tournamentId Int        @unique
  snapshot     Json
  assets       Json       @default("{}")
  generatedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model FamilyFeudGame {
  id               Int      @id @default(autoincrement())
  roomId           String   @unique
  alphaInviteToken String   @unique
  betaInviteToken  String   @unique
  state            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Member {
  id                   Int          @id @default(autoincrement())
  nickname             String
  user                 String       @unique
  passwordHash         String
  role                 MemberRole   @default(DEFAULT)
  profilePic           String?
  rank                 Int          @default(0)
  teamId               Int?
  heroVideoFolderPath  String?
  obsWebsocketUrl      String?
  obsWebsocketPassword String?
  team                 Team?        @relation(fields: [teamId], references: [id])
  playerStats          PlayerStat[]
}

model Team {
  id            Int           @id @default(autoincrement())
  name          String
  logo          String?
  roster        String?
  state         TeamState     @default(ACTIVE)
  victories     Int           @default(0)
  mapWins       Int           @default(0)
  mapLoses      Int           @default(0)
  tournamentId  Int
  discordRoleId String?
  defeats       Int           @default(0)
  bannerLeft    String?
  bannerRight   String?
  playoffSeed   Int?
  draftActions  DraftAction[]
  matchesA      Match[]       @relation("TeamA")
  matchesB      Match[]       @relation("TeamB")
  members       Member[]
  tournament    Tournament    @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, playoffSeed])
}

model Match {
  id                 Int          @id @default(autoincrement())
  type               MatchType
  bestOf             Int
  status             MatchStatus  @default(SCHEDULED)
  startDate          DateTime?
  tournamentId       Int
  teamAId            Int
  teamBId            Int
  teamAready         Int          @default(0)
  teamBready         Int          @default(0)
  pointsTeamA        Int          @default(0)
  pointsTeamB        Int          @default(0)
  mapWinsTeamA       Int          @default(0)
  mapWinsTeamB       Int          @default(0)
  gameNumber         Int          @default(0)
  semanas            Int?
  title              String?
  playoffRound       Int?
  playoffSlot        Int?
  mapsAllowedByRound Json?
  mapResults         Json?
  mapStartedAt       DateTime?
  mapTimerPaused     Boolean      @default(false)
  mapTimerPausedAt   DateTime?
  pauseRequestedAt   DateTime?
  pauseRequestedBy   Int?
  discordMessageId   String?
  draft              DraftTable?
  teamA              Team         @relation("TeamA", fields: [teamAId], references: [id])
  teamB              Team         @relation("TeamB", fields: [teamBId], references: [id])
  tournament         Tournament   @relation(fields: [tournamentId], references: [id])
  playerStats        PlayerStat[]
  allowedMaps        Map[]        @relation("AllowedMaps")
  leaderboardOverlay LeaderboardOverlayAsset?

  @@unique([tournamentId, playoffRound, playoffSlot])
}

model LeaderboardOverlayAsset {
  id                 Int      @id @default(autoincrement())
  matchId            Int      @unique
  backgroundImageUrl String?
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftTable {
  id                Int           @id @default(autoincrement())
  matchId           Int           @unique
  currentTurnTeamId Int?
  phase             String
  phaseStartedAt    DateTime      @default(now())
  bannedHeroes      Json
  pickedMaps        Json
  currentMapId      Int?
  actions           DraftAction[]
  match             Match         @relation(fields: [matchId], references: [id])
}

model DraftAction {
  id         Int             @id @default(autoincrement())
  draftId    Int
  teamId     Int
  action     DraftActionType
  value      Int?
  gameNumber Int             @default(1)
  order      Int
  createdAt  DateTime        @default(now())
  draft      DraftTable      @relation(fields: [draftId], references: [id])
  team       Team            @relation(fields: [teamId], references: [id])
}

model Map {
  id          Int     @id @default(autoincrement())
  type        MapType
  description String
  imgPath     String
  matches     Match[] @relation("AllowedMaps")
}

model Hero {
  id       Int      @id @default(autoincrement())
  name     String?
  role     HeroRole
  imgPath  String
  heroGift String?
}

model PlayerStat {
  id              Int      @id @default(autoincrement())
  damage          Int
  healing         Int
  mitigation      Int
  kills           Int
  assists         Int
  deaths          Int
  gameDuration    Int
  damagePer10     Float    @default(0)
  healingPer10    Float    @default(0)
  mitigationPer10 Float    @default(0)
  killsPer10      Float    @default(0)
  assistsPer10    Float    @default(0)
  deathsPer10     Float    @default(0)
  mapType         MapType
  role            HeroRole
  userId          Int
  createdAt       DateTime @default(now())
  matchId         Int
  gameNumber      Int
  match           Match    @relation(fields: [matchId], references: [id])
  user            Member   @relation(fields: [userId], references: [id])
}

enum TournamentState {
  SCHEDULED
  ROUNDROBIN
  PLAYOFFS
  SEMIFINALS
  FINALS
  FINISHED
}

enum MemberRole {
  ADMIN
  MANAGER
  CAPTAIN
  EDITOR
  DEFAULT
}

enum TeamState {
  ACTIVE
  ELIMINATED
}

enum MatchType {
  ROUNDROBIN
  PLAYINS
  PLAYOFFS
  SEMIFINALS
  FINALS
  PRACTICE
}

enum MatchStatus {
  SCHEDULED
  ACTIVE
  PENDINGREGISTERS
  FINISHED
}

enum MapType {
  CONTROL
  HYBRID
  PAYLOAD
  PUSH
  FLASHPOINT
}

enum HeroRole {
  TANK
  DPS
  SUPPORT
}

enum DraftActionType {
  BAN
  PICK
  SKIP
}

enum phase {
  STARTING
  MAPPICKING
  BAN
  PLAYING
  ENDMAP
  FINISHED
}
