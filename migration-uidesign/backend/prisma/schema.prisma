generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id            Int             @id @default(autoincrement())
  name          String
  startDate     DateTime
  state         TournamentState @default(SCHEDULED)
  matches       Match[]
  teams         Team[]
  seasonPlayers SeasonPlayer[]
}

model FamilyFeudGame {
  id               Int      @id @default(autoincrement())
  roomId           String   @unique
  alphaInviteToken String   @unique
  betaInviteToken  String   @unique
  phase            String   @default("notStarted")
  round            Int?
  state            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Identidad de la red Goonginga. La tabla legacy `Member` se mantiene intacta
/// durante la temporada actual de GGL; no deben mezclarse ambas entidades.
/// La pertenencia al Discord de GGL se verifica antes de crear este registro y
/// se conserva la fecha de la última validación para poder revalidarla después.
model NetworkMember {
  id                    Int                 @id @default(autoincrement())
  discordUserId         String              @unique
  username              String
  avatarUrl             String?
  roles                 NetworkMemberRole[] @default([MEMBER])
  status                NetworkMemberStatus @default(ACTIVE)
  nickname              String?
  profilePic            String?
  role                  MemberRole          @default(DEFAULT)
  rank                  Int                 @default(0)
  teamId                Int?
  heroVideoFolderPath   String?
  obsWebsocketUrl       String?
  obsWebsocketPassword  String?
  discordJoinedGglAt    DateTime?
  discordLastVerifiedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  seasonPlayers         SeasonPlayer[]
  team                  Team?               @relation(fields: [teamId], references: [id])
  playerStats           PlayerStat[]
  createdMiniGames      MiniGame[]          @relation("MiniGameCreator")
  underDevelopmentGames MiniGame[]          @relation("MiniGameDeveloper")

  @@index([status])
  @@index([teamId])
}

/// Minijuegos publicados en Goonginga Minigames. `config` contiene la
/// configuracion propia del tipo de juego y `state` solo el estado vivo de la
/// partida, para poder actualizarlo sin sobrescribir el contenido editorial.
model MiniGame {
  id                   Int            @id @default(autoincrement())
  slug                 String         @unique
  title                String
  description          String         @default("")
  coverImageUrl        String?
  gameType             MiniGameType   @default(JEOPARDY)
  status               MiniGameStatus @default(LIVE)
  config               Json           @default("{}")
  state                Json           @default("{}")
  createdById          Int
  underDevelopmentById Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  createdBy            NetworkMember  @relation("MiniGameCreator", fields: [createdById], references: [id], onDelete: Restrict)
  underDevelopmentBy   NetworkMember? @relation("MiniGameDeveloper", fields: [underDevelopmentById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdById])
}

/// Participación de un miembro de la red en una temporada o torneo.
/// Por ahora solo representa el vínculo; equipo, posición y estado competitivo
/// se agregarán cuando se defina el flujo de Season Player.
model SeasonPlayer {
  id           Int           @id @default(autoincrement())
  memberId     Int
  tournamentId Int
  joinedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  member       NetworkMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([memberId, tournamentId])
  @@index([tournamentId])
}

model Team {
  id            Int             @id @default(autoincrement())
  name          String
  logo          String?
  roster        String?
  state         TeamState       @default(ACTIVE)
  victories     Int             @default(0)
  mapWins       Int             @default(0)
  mapLoses      Int             @default(0)
  tournamentId  Int
  discordRoleId String?
  defeats       Int             @default(0)
  bannerLeft    String?
  bannerRight   String?
  playoffSeed   Int?
  draftActions  DraftAction[]
  matchesA      Match[]         @relation("TeamA")
  matchesB      Match[]         @relation("TeamB")
  members       NetworkMember[]
  tournament    Tournament      @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, playoffSeed])
}

model Match {
  id                 Int                      @id @default(autoincrement())
  type               MatchType
  bestOf             Int
  status             MatchStatus              @default(SCHEDULED)
  startDate          DateTime?
  tournamentId       Int
  teamAId            Int
  teamBId            Int
  teamAready         Int                      @default(0)
  teamBready         Int                      @default(0)
  pointsTeamA        Int                      @default(0)
  pointsTeamB        Int                      @default(0)
  mapWinsTeamA       Int                      @default(0)
  mapWinsTeamB       Int                      @default(0)
  gameNumber         Int                      @default(0)
  semanas            Int?
  title              String?
  playoffRound       Int?
  playoffSlot        Int?
  mapsAllowedByRound Json?
  mapResults         Json?
  mapStartedAt       DateTime?
  mapTimerPaused     Boolean                  @default(false)
  mapTimerPausedAt   DateTime?
  pauseRequestedAt   DateTime?
  pauseRequestedBy   Int?
  discordMessageId   String?
  draft              DraftTable?
  teamA              Team                     @relation("TeamA", fields: [teamAId], references: [id])
  teamB              Team                     @relation("TeamB", fields: [teamBId], references: [id])
  tournament         Tournament               @relation(fields: [tournamentId], references: [id])
  playerStats        PlayerStat[]
  allowedMaps        Map[]                    @relation("AllowedMaps")
  leaderboardOverlay LeaderboardOverlayAsset?

  @@unique([tournamentId, playoffRound, playoffSlot])
}

model LeaderboardOverlayAsset {
  id                 Int      @id @default(autoincrement())
  matchId            Int      @unique
  backgroundImageUrl String?
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftTable {
  id                Int           @id @default(autoincrement())
  matchId           Int           @unique
  currentTurnTeamId Int?
  phase             String
  phaseStartedAt    DateTime      @default(now())
  bannedHeroes      Json
  pickedMaps        Json
  currentMapId      Int?
  actions           DraftAction[]
  match             Match         @relation(fields: [matchId], references: [id])
}

model DraftAction {
  id         Int             @id @default(autoincrement())
  draftId    Int
  teamId     Int
  action     DraftActionType
  value      Int?
  gameNumber Int             @default(1)
  order      Int
  createdAt  DateTime        @default(now())
  draft      DraftTable      @relation(fields: [draftId], references: [id])
  team       Team            @relation(fields: [teamId], references: [id])
}

model Map {
  id          Int     @id @default(autoincrement())
  type        MapType
  description String
  imgPath     String
  matches     Match[] @relation("AllowedMaps")
}

model Hero {
  id       Int      @id @default(autoincrement())
  name     String?
  role     HeroRole
  imgPath  String
  heroGift String?
}

model PlayerStat {
  id              Int           @id @default(autoincrement())
  damage          Int
  healing         Int
  mitigation      Int
  kills           Int
  assists         Int
  deaths          Int
  gameDuration    Int
  damagePer10     Float         @default(0)
  healingPer10    Float         @default(0)
  mitigationPer10 Float         @default(0)
  killsPer10      Float         @default(0)
  assistsPer10    Float         @default(0)
  deathsPer10     Float         @default(0)
  mapType         MapType
  role            HeroRole
  userId          Int
  createdAt       DateTime      @default(now())
  matchId         Int
  gameNumber      Int
  match           Match         @relation(fields: [matchId], references: [id])
  user            NetworkMember @relation(fields: [userId], references: [id])
}

enum TournamentState {
  SCHEDULED
  ROUNDROBIN
  PLAYOFFS
  SEMIFINALS
  FINALS
  FINISHED
}

enum MemberRole {
  ADMIN
  MANAGER
  CAPTAIN
  EDITOR
  DEFAULT
}

enum NetworkMemberRole {
  MEMBER
  ADMIN
  CASTER
  DEVELOPER
  SEASON_PLAYER
  MODERATOR
  COMMUNITY_MANAGER
  CONTENT_CREATOR
  SOCIAL_MEDIA
}

enum MiniGameType {
  JEOPARDY
  FAMILY_FEUD
  CUSTOM
}

enum MiniGameStatus {
  LIVE
  UNDER_DEVELOPMENT
}

enum NetworkMemberStatus {
  ACTIVE
  SUSPENDED
}

enum TeamState {
  ACTIVE
  ELIMINATED
}

enum MatchType {
  ROUNDROBIN
  PLAYINS
  PLAYOFFS
  SEMIFINALS
  FINALS
  PRACTICE
}

enum MatchStatus {
  SCHEDULED
  ACTIVE
  PENDINGREGISTERS
  FINISHED
}

enum MapType {
  CONTROL
  HYBRID
  PAYLOAD
  PUSH
  FLASHPOINT
}

enum HeroRole {
  TANK
  DPS
  SUPPORT
}

enum DraftActionType {
  BAN
  PICK
  SKIP
}

enum phase {
  STARTING
  MAPPICKING
  BAN
  PLAYING
  ENDMAP
  FINISHED
}
