generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id            Int             @id @default(autoincrement())
  name          String
  startDate     DateTime
  state         TournamentState @default(SCHEDULED)
  matches       Match[]
  teams         Team[]
  seasonPlayers SeasonPlayer[]
}

model FamilyFeudGame {
  id               Int               @id @default(autoincrement())
  roomId           String            @unique
  alphaInviteToken String            @unique
  betaInviteToken  String            @unique
  phase            String            @default("notStarted")
  round            Int?
  state            Json
  code             String?           @unique
  title            String            @default("Family Feud")
  status           FeudGameStatus    @default(LOBBY)
  managerMemberId  Int?
  winningTeamId    Int?
  version          Int               @default(1)
  developmentMode  Boolean           @default(false)
  timerEndsAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  manager          NetworkMember?    @relation("FeudGameManager", fields: [managerMemberId], references: [id], onDelete: Restrict)
  winningTeam      FeudTeam?         @relation("FeudWinningTeam", fields: [winningTeamId], references: [id], onDelete: SetNull)
  teams            FeudTeam[]
  participants     FeudParticipant[]
  rounds           FeudRound[]

  @@index([status, createdAt])
  @@index([managerMemberId])
}

model FeudTeam {
  id                Int               @id @default(autoincrement())
  gameId            Int
  side              FeudTeamSide
  name              String
  color             String
  score             Int               @default(0)
  captainMemberId   Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  game              FamilyFeudGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  captain           NetworkMember?    @relation("FeudTeamCaptain", fields: [captainMemberId], references: [id], onDelete: SetNull)
  participants      FeudParticipant[]
  activeRounds      FeudRound[]       @relation("FeudRoundActiveTeam")
  wonGames          FamilyFeudGame[]  @relation("FeudWinningTeam")
  familyFaceOffWins FeudFaceOff[]     @relation("FeudFamilyWinnerTeam")

  @@unique([gameId, side])
  @@index([captainMemberId])
}

model FeudParticipant {
  id         Int                 @id @default(autoincrement())
  gameId     Int
  teamId     Int?
  memberId   Int
  role       FeudParticipantRole @default(PLAYER)
  ready      Boolean             @default(false)
  joinedAt   DateTime            @default(now())
  lastSeenAt DateTime            @default(now())
  game       FamilyFeudGame      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team       FeudTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  member     NetworkMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  responses  FeudResponse[]

  @@unique([gameId, memberId])
  @@index([teamId])
  @@index([memberId])
}

model FeudQuestion {
  id          Int           @id @default(autoincrement())
  question    String
  category    String        @default("GENERAL")
  pack        String        @default("Core Set")
  active      Boolean       @default(true)
  createdById Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   NetworkMember @relation("FeudQuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  answers     FeudAnswer[]
  rounds      FeudRound[]

  @@index([active, category])
  @@index([createdById])
}

model FeudAnswer {
  id         Int            @id @default(autoincrement())
  questionId Int
  answer     String
  points     Int
  rank       Int
  aliases    String[]       @default([])
  question   FeudQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  FeudResponse[]

  @@unique([questionId, rank])
  @@index([questionId])
}

model FeudRound {
  id           Int             @id @default(autoincrement())
  gameId       Int
  questionId   Int
  roundNumber  Int
  multiplier   Int             @default(1)
  activeTeamId Int?
  roundBank    Int             @default(0)
  strikes      Int             @default(0)
  status       FeudRoundStatus @default(ROUND_INTRO)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  game         FamilyFeudGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question     FeudQuestion    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  activeTeam   FeudTeam?       @relation("FeudRoundActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)
  responses    FeudResponse[]
  faceOff      FeudFaceOff?

  @@unique([gameId, roundNumber])
  @@index([questionId])
  @@index([activeTeamId])
}

model FeudResponse {
  id              Int              @id @default(autoincrement())
  roundId         Int
  participantId   Int?
  memberId        Int?
  text            String
  matchedAnswerId Int?
  correct         Boolean?
  points          Int              @default(0)
  responseType    FeudResponseType @default(ROUND)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  round           FeudRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant     FeudParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  member          NetworkMember?   @relation("FeudResponseMember", fields: [memberId], references: [id], onDelete: SetNull)
  matchedAnswer   FeudAnswer?      @relation(fields: [matchedAnswerId], references: [id], onDelete: SetNull)

  @@index([roundId, createdAt])
  @@index([memberId])
  @@index([matchedAnswerId])
}

model FeudFaceOff {
  id                     Int            @id @default(autoincrement())
  roundId                Int            @unique
  teamARepresentativeId  Int
  teamBRepresentativeId  Int
  externalWinnerMemberId Int?
  familyWinnerTeamId     Int?
  createdAt              DateTime       @default(now())
  resolvedAt             DateTime?
  round                  FeudRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamARepresentative    NetworkMember  @relation("FeudFaceOffTeamA", fields: [teamARepresentativeId], references: [id], onDelete: Restrict)
  teamBRepresentative    NetworkMember  @relation("FeudFaceOffTeamB", fields: [teamBRepresentativeId], references: [id], onDelete: Restrict)
  externalWinner         NetworkMember? @relation("FeudExternalWinner", fields: [externalWinnerMemberId], references: [id], onDelete: SetNull)
  familyWinnerTeam       FeudTeam?      @relation("FeudFamilyWinnerTeam", fields: [familyWinnerTeamId], references: [id], onDelete: SetNull)

  @@index([externalWinnerMemberId])
  @@index([familyWinnerTeamId])
}

/// Identidad de la red Goonginga. La tabla legacy `Member` se mantiene intacta
/// durante la temporada actual de GGL; no deben mezclarse ambas entidades.
/// La pertenencia al Discord de GGL se verifica antes de crear este registro y
/// se conserva la fecha de la última validación para poder revalidarla después.
model NetworkMember {
  id                     Int                   @id @default(autoincrement())
  discordUserId          String                @unique
  username               String
  avatarUrl              String?
  roles                  NetworkMemberRole[]   @default([MEMBER])
  status                 NetworkMemberStatus   @default(ACTIVE)
  nickname               String?
  profilePic             String?
  role                   MemberRole            @default(DEFAULT)
  rank                   Int                   @default(0)
  teamId                 Int?
  heroVideoFolderPath    String?
  obsWebsocketUrl        String?
  obsWebsocketPassword   String?
  discordJoinedGglAt     DateTime?
  discordLastVerifiedAt  DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  seasonPlayers          SeasonPlayer[]
  team                   Team?                 @relation(fields: [teamId], references: [id])
  playerStats            PlayerStat[]
  createdMiniGames       MiniGame[]            @relation("MiniGameCreator")
  announcements          Announcement[]        @relation("AnnouncementCreator")
  underDevelopmentGames  MiniGame[]            @relation("MiniGameDeveloper")
  miniGameParticipations MiniGameParticipant[]
  managedFeudGames       FamilyFeudGame[]      @relation("FeudGameManager")
  captainedFeudTeams     FeudTeam[]            @relation("FeudTeamCaptain")
  feudParticipations     FeudParticipant[]
  createdFeudQuestions   FeudQuestion[]        @relation("FeudQuestionCreator")
  feudResponses          FeudResponse[]        @relation("FeudResponseMember")
  feudFaceOffsAsTeamA    FeudFaceOff[]         @relation("FeudFaceOffTeamA")
  feudFaceOffsAsTeamB    FeudFaceOff[]         @relation("FeudFaceOffTeamB")
  feudExternalWins       FeudFaceOff[]         @relation("FeudExternalWinner")

  @@index([status])
  @@index([teamId])
}

/// Minijuegos publicados en Goonginga Minigames. `config` contiene la
/// configuracion propia del tipo de juego y `state` solo el estado vivo de la
/// partida, para poder actualizarlo sin sobrescribir el contenido editorial.
model MiniGame {
  id                   Int                   @id @default(autoincrement())
  slug                 String                @unique
  title                String
  description          String                @default("")
  coverImageUrl        String?
  gameType             MiniGameType          @default(JEOPARDY)
  status               MiniGameStatus        @default(LIVE)
  phase                JeopardyPhase         @default(CREATED)
  config               Json                  @default("{}")
  state                Json                  @default("{}")
  createdById          Int
  underDevelopmentById Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            NetworkMember         @relation("MiniGameCreator", fields: [createdById], references: [id], onDelete: Restrict)
  underDevelopmentBy   NetworkMember?        @relation("MiniGameDeveloper", fields: [underDevelopmentById], references: [id], onDelete: SetNull)
  participants         MiniGameParticipant[]

  @@index([status, createdAt])
  @@index([createdById])
}

model MiniGameParticipant {
  id        Int           @id @default(autoincrement())
  gameId    Int
  memberId  Int
  score     Int           @default(0)
  joinedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  game      MiniGame      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  member    NetworkMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gameId, memberId])
  @@index([gameId, score])
  @@index([memberId])
}

/// Un anuncio guardado. `content` tiene la forma que declara su plantilla
/// (ver backend/announcements/templates). Publicado o no lo decide
/// AnnouncementMode.publishedId, por eso aqui no hay campo de estado.
model Announcement {
  id          Int                @id @default(autoincrement())
  name        String
  type        AnnouncementType
  content     Json               @default("{}")
  countdownAt DateTime?
  createdById Int
  updatedById Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   NetworkMember      @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedIn AnnouncementMode[] @relation("PublishedAnnouncement")

  @@index([type, updatedAt])
}

/// Estado editorial principal del sitio. Sigue siendo un singleton (id 1);
/// ahora solo apunta al anuncio publicado en lugar de contenerlo.
model AnnouncementMode {
  id          Int           @id @default(1)
  enabled     Boolean       @default(true)
  publishedId Int?
  published   Announcement? @relation("PublishedAnnouncement", fields: [publishedId], references: [id], onDelete: SetNull)
  updatedById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Participación de un miembro de la red en una temporada o torneo.
/// Por ahora solo representa el vínculo; equipo, posición y estado competitivo
/// se agregarán cuando se defina el flujo de Season Player.
model SeasonPlayer {
  id           Int           @id @default(autoincrement())
  memberId     Int
  tournamentId Int
  joinedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  member       NetworkMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([memberId, tournamentId])
  @@index([tournamentId])
}

model Team {
  id            Int             @id @default(autoincrement())
  name          String
  logo          String?
  roster        String?
  state         TeamState       @default(ACTIVE)
  victories     Int             @default(0)
  mapWins       Int             @default(0)
  mapLoses      Int             @default(0)
  tournamentId  Int
  discordRoleId String?
  defeats       Int             @default(0)
  bannerLeft    String?
  bannerRight   String?
  playoffSeed   Int?
  draftActions  DraftAction[]
  matchesA      Match[]         @relation("TeamA")
  matchesB      Match[]         @relation("TeamB")
  members       NetworkMember[]
  tournament    Tournament      @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, playoffSeed])
}

model Match {
  id                 Int                      @id @default(autoincrement())
  type               MatchType
  bestOf             Int
  status             MatchStatus              @default(SCHEDULED)
  startDate          DateTime?
  tournamentId       Int
  teamAId            Int
  teamBId            Int
  teamAready         Int                      @default(0)
  teamBready         Int                      @default(0)
  pointsTeamA        Int                      @default(0)
  pointsTeamB        Int                      @default(0)
  mapWinsTeamA       Int                      @default(0)
  mapWinsTeamB       Int                      @default(0)
  gameNumber         Int                      @default(0)
  semanas            Int?
  title              String?
  playoffRound       Int?
  playoffSlot        Int?
  mapsAllowedByRound Json?
  mapResults         Json?
  mapStartedAt       DateTime?
  mapTimerPaused     Boolean                  @default(false)
  mapTimerPausedAt   DateTime?
  pauseRequestedAt   DateTime?
  pauseRequestedBy   Int?
  discordMessageId   String?
  draft              DraftTable?
  teamA              Team                     @relation("TeamA", fields: [teamAId], references: [id])
  teamB              Team                     @relation("TeamB", fields: [teamBId], references: [id])
  tournament         Tournament               @relation(fields: [tournamentId], references: [id])
  playerStats        PlayerStat[]
  allowedMaps        Map[]                    @relation("AllowedMaps")
  leaderboardOverlay LeaderboardOverlayAsset?

  @@unique([tournamentId, playoffRound, playoffSlot])
}

model LeaderboardOverlayAsset {
  id                 Int      @id @default(autoincrement())
  matchId            Int      @unique
  backgroundImageUrl String?
  settings           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftTable {
  id                Int           @id @default(autoincrement())
  matchId           Int           @unique
  currentTurnTeamId Int?
  phase             String
  phaseStartedAt    DateTime      @default(now())
  bannedHeroes      Json
  pickedMaps        Json
  currentMapId      Int?
  actions           DraftAction[]
  match             Match         @relation(fields: [matchId], references: [id])
}

model DraftAction {
  id         Int             @id @default(autoincrement())
  draftId    Int
  teamId     Int
  action     DraftActionType
  value      Int?
  gameNumber Int             @default(1)
  order      Int
  createdAt  DateTime        @default(now())
  draft      DraftTable      @relation(fields: [draftId], references: [id])
  team       Team            @relation(fields: [teamId], references: [id])
}

model Map {
  id          Int     @id @default(autoincrement())
  type        MapType
  description String
  imgPath     String
  matches     Match[] @relation("AllowedMaps")
}

model Hero {
  id       Int      @id @default(autoincrement())
  name     String?
  role     HeroRole
  imgPath  String
  heroGift String?
}

model PlayerStat {
  id              Int           @id @default(autoincrement())
  damage          Int
  healing         Int
  mitigation      Int
  kills           Int
  assists         Int
  deaths          Int
  gameDuration    Int
  damagePer10     Float         @default(0)
  healingPer10    Float         @default(0)
  mitigationPer10 Float         @default(0)
  killsPer10      Float         @default(0)
  assistsPer10    Float         @default(0)
  deathsPer10     Float         @default(0)
  mapType         MapType
  role            HeroRole
  userId          Int
  createdAt       DateTime      @default(now())
  matchId         Int
  gameNumber      Int
  match           Match         @relation(fields: [matchId], references: [id])
  user            NetworkMember @relation(fields: [userId], references: [id])
}

enum TournamentState {
  SCHEDULED
  ROUNDROBIN
  PLAYOFFS
  SEMIFINALS
  FINALS
  FINISHED
}

enum MemberRole {
  ADMIN
  MANAGER
  CAPTAIN
  EDITOR
  DEFAULT
}

enum NetworkMemberRole {
  MEMBER
  ADMIN
  CASTER
  DEVELOPER
  SEASON_PLAYER
  MODERATOR
  COMMUNITY_MANAGER
  CONTENT_CREATOR
  SOCIAL_MEDIA
}

enum MiniGameType {
  JEOPARDY
  FAMILY_FEUD
  CUSTOM
}

enum FeudGameStatus {
  LOBBY
  ROUND_INTRO
  AWAITING_EXTERNAL_FACE_OFF
  FACE_OFF_FIRST_ANSWER
  FACE_OFF_SECOND_ANSWER
  PLAY_PASS
  ROUND_PLAY
  STEAL
  ROUND_RESULTS
  FAST_MONEY
  FINISHED
  PAUSED
}

enum FeudTeamSide {
  ALPHA
  BETA
}

enum FeudParticipantRole {
  MANAGER
  PLAYER
  SPECTATOR
}

enum FeudRoundStatus {
  ROUND_INTRO
  AWAITING_EXTERNAL_FACE_OFF
  FACE_OFF
  PLAY_PASS
  ROUND_PLAY
  STEAL
  ROUND_RESULTS
  FINISHED
}

enum FeudResponseType {
  FACE_OFF
  ROUND
  STEAL_SUGGESTION
  STEAL_FINAL
  FAST_MONEY
}

enum MiniGameStatus {
  LIVE
  UNDER_DEVELOPMENT
}

enum JeopardyPhase {
  CREATED
  PICKING_MEMBER
  PICKING_QUESTION
  RESPONDING
  RESPONDED
  FINALIZED
}

enum AnnouncementType {
  TOURNAMENT
  MINIGAME
  CUSTOM
}

enum NetworkMemberStatus {
  ACTIVE
  SUSPENDED
}

enum TeamState {
  ACTIVE
  ELIMINATED
}

enum MatchType {
  ROUNDROBIN
  PLAYINS
  PLAYOFFS
  SEMIFINALS
  FINALS
  PRACTICE
}

enum MatchStatus {
  SCHEDULED
  ACTIVE
  PENDINGREGISTERS
  FINISHED
}

enum MapType {
  CONTROL
  HYBRID
  PAYLOAD
  PUSH
  FLASHPOINT
}

enum HeroRole {
  TANK
  DPS
  SUPPORT
}

enum DraftActionType {
  BAN
  PICK
  SKIP
}

enum phase {
  STARTING
  MAPPICKING
  BAN
  PLAYING
  ENDMAP
  FINISHED
}
