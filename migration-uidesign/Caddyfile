# Caddy obtains and renews the public TLS certificate automatically when
# GOON_DOMAIN resolves to this VPS and ports 80/443 are reachable.
{$GOON_DOMAIN} {
	encode zstd gzip

	# A single temporary DuckDNS hostname serves both Next.js and Express.
	handle /backend {
		redir /backend/ permanent
	}
	handle_path /backend/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:3001
	}
}

# Goonginga Minigames is intentionally a separate frontend, while it shares
# the main API and Network Users database through the public backend URL.
{$GOON_GAMENIGHTS_DOMAIN} {
	encode zstd gzip

	handle {
		reverse_proxy minigames:3001
	}
}
