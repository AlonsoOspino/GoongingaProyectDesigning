# Spring does not load this file automatically. Export variables or use Compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/goonginga_local
SPRING_DATASOURCE_USERNAME=goonginga
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
NETWORK_JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_SECRET=replace-with-existing-second-signing-key-if-needed
DRAFT_TABLE_MANAGER_KEY=replace-with-existing-obs-share-key
PORT=3002
DRAFT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DRAFT_FLYWAY_ENABLED=true
MEDIA_DIR=uploads
APP_URL=http://localhost:3002
NETWORK_FRONTEND_URL=http://localhost:3000
NETWORK_MINIGAMES_FRONTEND_URL=http://localhost:3001
NETWORK_AUTH_PUBLIC_PATH_PREFIX=
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-secret
DISCORD_GUILD_ID=replace-with-guild-id
DISCORD_REDIRECT_URI=http://localhost:3002/network-auth/discord/callback
